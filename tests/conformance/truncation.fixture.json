        "pathDepth": 1
      },
      "payload": {
        "workspace": {
          "current_dir": "/home/user/project"
        }
      }
    },
    {
      "name": "pathDepth leaves shallow paths alone",
      "field": {
        "type": "field",
        "key": "cwd",
        "dataType": "string",
        "pathDepth": 5
      },
      "payload": {
        "cwd": "D:\\dev"
      }
    },
    {
      "name": "maxLength is ignored on path keys",
      "field": {
        "type": "field",
        "key": "cwd",
        "dataType": "string",
        "maxLength": 3
      },
      "payload": {
        "cwd": "D:\\Development\\ccstatusline"
      }
    },
    {
      "name": "pathDepth is ignored on non-path keys",
