{
  "_comment": "Truncate-Text / Truncate-Path by field kind and Get-FieldRawValue key normalization.",
  "now": 1757000000,
  "cases": [
    {
      "name": "maxLength shortens with ellipsis",
      "field": {
        "type": "field",
        "key": "model.display_name",
        "dataType": "string",
        "maxLength": 5
      },
      "payload": {
        "model": {
          "display_name": "Claude Opus"
        }
      }
    },
    {
      "name": "maxLength one yields only the ellipsis",
      "field": {
        "type": "field",
        "key": "model.display_name",
        "dataType": "string",
        "maxLength": 1
      },
      "payload": {
        "model": {
          "display_name": "Claude"
        }
      }
    },
    {
      "name": "maxLength leaves short values alone",
      "field": {
        "type": "field",
        "key": "model.display_name",
        "dataType": "string",
        "maxLength": 20
      },
      "payload": {
        "model": {
          "display_name": "Claude"
        }
      }
    },
    {
      "name": "pathDepth keeps trailing segments with backslashes",
      "field": {
        "type": "field",
        "key": "cwd",
        "dataType": "string",
        "pathDepth": 2
      },
      "payload": {
        "cwd": "D:\\Development\\ccstatusline\\tests"
      }
    },
    {
      "name": "pathDepth keeps trailing segments with slashes",
      "field": {
        "type": "field",
        "key": "workspace.current_dir",
